# Copy to .env (never commit .env). All variables are prefixed AGENT_.
AGENT_ENV=dev                      # dev | test | prod  (prod refuses insecure defaults)
AGENT_LLM_MODEL=fake               # fake | anthropic:<model> | openai:<model>
# AGENT_JWT_SECRET=               # REQUIRED in prod: random, >= 32 chars (openssl rand -hex 32)
AGENT_JWT_ISSUER=ent-idp
AGENT_JWT_AUDIENCE=ent-agent
# AGENT_CHECKPOINT_URL=           # REQUIRED in prod: postgresql://user:pass@host:5432/db
AGENT_AUDIT_LOG_PATH=audit.log.jsonl
AGENT_ALLOWED_FETCH_DOMAINS=[]     # JSON list, e.g. ["docs.example.com"]
AGENT_RATE_LIMIT_PER_MINUTE=30
AGENT_DAILY_TOKEN_BUDGET_PER_USER=200000
AGENT_MAX_AGENT_STEPS=6
AGENT_REFUND_HARD_LIMIT=500
# Provider keys use the provider's standard variable, e.g. ANTHROPIC_API_KEY / OPENAI_API_KEY
